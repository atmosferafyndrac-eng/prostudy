# Copy to .env; NEVER upload this file with real credentials to a public repo.
HOST=127.0.0.1
PORT=8080
# Use HTTPS URL of your actual domain in production. Used for secure admin cookie.
PUBLIC_URL=http://localhost:8080
# Change to a strong unique password BEFORE enabling admin.
ADMIN_PASSWORD=
# Telegram: create a bot at @BotFather, get token and numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional email notifications. SMTP_PORT=465 uses SSL, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# Optional: absolute persistent path for SQLite, default ./data
DATA_DIR=
